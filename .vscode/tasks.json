{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file",
            "command": "C:\\MinGW\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-I${workspaceFolder}/HeaderFiles",
                "-I${workspaceFolder}/HeaderFiles/TypeHeaderFiles",
                "${workspaceFolder}/ImplementFiles/*.cpp",
                "${workspaceFolder}/ImplementFiles/TypeImplementFiles/*.cpp",
                "${workspaceFolder}/*.cpp",
                "-o",
                "${workspaceFolder}\\Account.exe"
                
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}